layout(std430, binding = 0) readonly buffer Tris { uint g_tris[]; };
layout(std430, binding = 1) readonly buffer Nodes { uint g_nodes[]; };
layout(std430, binding = 2) readonly buffer Texels { uint g_texels[]; };
layout(std430, binding = 3) readonly buffer Lights { uint g_lights[]; };
layout(std430, binding = 4) readonly buffer Emi { uint g_emi[]; };
layout(std430, binding = 5) readonly buffer TexW { uint g_texw[]; };
layout(std430, binding = 6) readonly buffer TexM { uint g_texm[]; };
layout(std430, binding = 7) readonly buffer BN { uint g_bn[]; };
layout(std430, binding = 8) readonly buffer Par { uint g_par[]; };
layout(std430, binding = 9) readonly buffer TriIdx { uint g_triIdx[]; };
layout(std430, binding = 10) buffer OutDen { uint o_den[]; };
layout(std430, binding = 11) buffer OutVar { uint o_var[]; };
layout(std430, binding = 12) buffer OutStl { uint o_stl[]; };
layout(std430, binding = 13) buffer OutStc { uint o_stc[]; };
#define TRI_BYTES 88
#define NODE_BYTES 40
#define pSunDirTo 0
#define pSunCol 3
#define pSkyTop 6
#define pSkyHor 9
#define pSkyGnd 12
#define pSkyAvg 15
#define pSkyLevel 18
#define pSkyNeut 19
